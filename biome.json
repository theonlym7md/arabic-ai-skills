{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!dist", "!!node_modules", "!!coverage"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/routing.generated.ts"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["docs/demos/login-build/*/index.html"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "suspicious": { "useIterableCallbackReturn": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
