{
  "name": "arabic_skill",
  "version": "1.2.0",
  "description": "Arabic Intelligence Framework - A structured reasoning framework for Arabic UX writing, product copy, and AI agents.",
  "main": "dist/index.js",
  "private": true,
  "workspaces": [
    "skills/*"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate_all.js",
    "benchmark": "node scripts/run_benchmark.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run validate && npm run typecheck && npm test && npm run lint",
    "package:zip": "node scripts/package_zip.js"
  },
  "keywords": [
    "ai",
    "agents",
    "arabic",
    "ux",
    "copywriting",
    "microcopy",
    "prompt-engineering"
  ],
  "author": "UX Microcopy Architect",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "openai": "^6.48.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^20.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.0.0",
    "yaml": "^2.8.1"
  }
}
