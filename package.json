{
  "name": "arabicskill",
  "version": "2.3.0",
  "description": "ArabicSkill: Arabic product copywriting, safe JSON/ICU localization, dialect adaptation, and SDK utilities for AI agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/esm/package.json",
    "!dist/*.zip",
    "skills/arabicskill/SKILL.md",
    "skills/arabicskill/references/dialects.md",
    "skills/arabicskill/references/experience-patterns.md",
    "skills/arabicskill/references/localization.md",
    "skills/arabicskill/references/sector-patterns.md",
    "skills/arabicskill/references/sensitive-states.md",
    "skills/arabicskill/references/ui-flows.md",
    "skills/arabicskill/knowledge/relations/routing.yaml",
    "skills/arabicskill/knowledge/relations/weights.yaml",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theonlym7md/arabic-ai-skills.git"
  },
  "homepage": "https://skills.sh/theonlym7md/arabic-ai-skills/arabicskill",
  "bugs": {
    "url": "https://github.com/theonlym7md/arabic-ai-skills/issues"
  },
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "build:routing": "node scripts/build_routing.js",
    "build": "node scripts/build_dual.js",
    "typecheck": "node scripts/build_routing.js --check && tsc --noEmit && tsc -p tsconfig.esm.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate_all.js",
    "sweep": "node scripts/sweep.js",
    "benchmark": "node scripts/run_benchmark.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run validate && npm run sweep && npm test && npm run lint",
    "package:zip": "node scripts/package_zip.js"
  },
  "keywords": [
    "ai",
    "agents",
    "arabic",
    "ux-writing",
    "copywriting",
    "microcopy",
    "prompt-engineering",
    "agent-skills",
    "rtl",
    "localization",
    "icu"
  ],
  "author": "theonlym7md",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.3",
    "ajv": "^8.17.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
